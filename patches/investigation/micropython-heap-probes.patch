+    size_t first = (module_name + function_name + type_name + kind) % PY_ALLOC_DIAG_SITE_COUNT;
+    for (size_t offset = 0; offset < PY_ALLOC_DIAG_SITE_COUNT; ++offset) {
+        py_alloc_diag_site_t *site = &py_alloc_diag_sites[(first + offset) % PY_ALLOC_DIAG_SITE_COUNT];
+        if (site->calls == 0 || (site->module_name == module_name
+                && site->function_name == function_name && site->type_name == type_name
+                && site->kind == kind)) {
+            site->module_name = module_name;
+            site->function_name = function_name;
+            site->type_name = type_name;
+            site->kind = kind;
+            site->calls += 1;
+            site->bytes += alloc_bytes;
+            return;
+        }
+    }
+    py_alloc_diag_overflow_calls[kind] += 1;
+    py_alloc_diag_overflow_bytes[kind] += alloc_bytes;
+}
+
+void mp_obj_fun_bc_alloc_diag_record(const mp_obj_fun_bc_t *fun, size_t alloc_bytes) {
+    mp_obj_t module_name_obj = mp_obj_dict_get(
+        MP_OBJ_FROM_PTR(fun->context->module.globals), MP_OBJ_NEW_QSTR(MP_QSTR___name__));
+    qstr module_name = mp_obj_str_get_qstr(module_name_obj);
+    qstr function_name = mp_obj_fun_bc_get_name(fun);
+    size_t first = (module_name + function_name) % FUN_BC_ALLOC_DIAG_SITE_COUNT;
+
+    for (size_t offset = 0; offset < FUN_BC_ALLOC_DIAG_SITE_COUNT; ++offset) {
+        fun_bc_alloc_diag_site_t *site = &fun_bc_alloc_diag_sites[(first + offset) % FUN_BC_ALLOC_DIAG_SITE_COUNT];
+        if (site->calls == 0 || (site->module_name == module_name && site->function_name == function_name)) {
+            site->module_name = module_name;
+            site->function_name = function_name;
+            site->calls += 1;
+            site->bytes += alloc_bytes;
+            return;
+        }
+    }
+
+    fun_bc_alloc_diag_overflow_calls += 1;
+    fun_bc_alloc_diag_overflow_bytes += alloc_bytes;
+}
+
+void mp_obj_fun_bc_alloc_diag_report(void) {
+    for (size_t rank = 0; rank < FUN_BC_ALLOC_DIAG_TOP_COUNT; ++rank) {
+        size_t top = FUN_BC_ALLOC_DIAG_SITE_COUNT;
+        size_t max_bytes = 0;
+        for (size_t i = 0; i < FUN_BC_ALLOC_DIAG_SITE_COUNT; ++i) {
+            if (fun_bc_alloc_diag_sites[i].bytes > max_bytes) {
+                top = i;
+                max_bytes = fun_bc_alloc_diag_sites[i].bytes;
+            }
+        }
+        if (top == FUN_BC_ALLOC_DIAG_SITE_COUNT) {
+            break;
+        }
+        fun_bc_alloc_diag_site_t *site = &fun_bc_alloc_diag_sites[top];
+        mp_printf(&mp_plat_print,
+            "GC_FRAME_SITE module=%q function=%q calls=" UINT_FMT " bytes=" UINT_FMT "\n",
+            site->module_name, site->function_name, (mp_uint_t)site->calls,
+            (mp_uint_t)site->bytes);
+        site->bytes = 0;
+    }
+    if (fun_bc_alloc_diag_overflow_calls != 0) {
+        mp_printf(&mp_plat_print,
+            "GC_FRAME_SITE module=other function=other calls=" UINT_FMT " bytes=" UINT_FMT "\n",
+            (mp_uint_t)fun_bc_alloc_diag_overflow_calls,
+            (mp_uint_t)fun_bc_alloc_diag_overflow_bytes);
+    }
+    for (size_t rank = 0; rank < PY_ALLOC_DIAG_TOP_COUNT; ++rank) {
+        size_t top = PY_ALLOC_DIAG_SITE_COUNT;
+        size_t max_bytes = 0;
+        for (size_t i = 0; i < PY_ALLOC_DIAG_SITE_COUNT; ++i) {
+            if (py_alloc_diag_sites[i].bytes > max_bytes) {
+                top = i;
+                max_bytes = py_alloc_diag_sites[i].bytes;
+            }
+        }
+        if (top == PY_ALLOC_DIAG_SITE_COUNT) {
+            break;
+        }
+        py_alloc_diag_site_t *site = &py_alloc_diag_sites[top];
+        if (site->kind == MP_GC_ALLOC_DIAG_HEADER) {
+            mp_printf(&mp_plat_print,
+                "GC_PY_ALLOC_SITE kind=header type=%q module=%q function=%q count=" UINT_FMT " request=" UINT_FMT "B\n",
+                site->type_name, site->module_name, site->function_name,
+                (mp_uint_t)site->calls, (mp_uint_t)site->bytes);
+        } else if (site->kind == MP_GC_ALLOC_DIAG_MPZ_DIGITS) {
+            mp_printf(&mp_plat_print,
+                "GC_PY_ALLOC_SITE kind=mpz_digits module=%q function=%q count=" UINT_FMT " request=" UINT_FMT "B\n",
+                site->module_name, site->function_name, (mp_uint_t)site->calls,
+                (mp_uint_t)site->bytes);
+        } else {
+            mp_printf(&mp_plat_print,
+                "GC_PY_ALLOC_SITE kind=float module=%q function=%q count=" UINT_FMT " request=" UINT_FMT "B\n",
+                site->module_name, site->function_name, (mp_uint_t)site->calls,
+                (mp_uint_t)site->bytes);
+        }
+        site->bytes = 0;
+    }
+    for (size_t kind = 0; kind < MP_ARRAY_SIZE(py_alloc_diag_overflow_calls); ++kind) {
+        if (py_alloc_diag_overflow_calls[kind] != 0) {
+            mp_printf(&mp_plat_print,
+                "GC_PY_ALLOC_SITE kind=%s other count=" UINT_FMT " request=" UINT_FMT "B\n",
+                kind == MP_GC_ALLOC_DIAG_HEADER ? "header"
+                    : kind == MP_GC_ALLOC_DIAG_MPZ_DIGITS ? "mpz_digits" : "float",
+                (mp_uint_t)py_alloc_diag_overflow_calls[kind],
+                (mp_uint_t)py_alloc_diag_overflow_bytes[kind]);
+        }
+    }
+    memset(fun_bc_alloc_diag_sites, 0, sizeof(fun_bc_alloc_diag_sites));
+    fun_bc_alloc_diag_overflow_calls = 0;
+    fun_bc_alloc_diag_overflow_bytes = 0;
+    memset(py_alloc_diag_sites, 0, sizeof(py_alloc_diag_sites));
+    memset(py_alloc_diag_overflow_calls, 0, sizeof(py_alloc_diag_overflow_calls));
+    memset(py_alloc_diag_overflow_bytes, 0, sizeof(py_alloc_diag_overflow_bytes));
+}
+
+void mp_obj_fun_bc_alloc_diag_reset(void) {
+    memset(fun_bc_alloc_diag_sites, 0, sizeof(fun_bc_alloc_diag_sites));
+    fun_bc_alloc_diag_overflow_calls = 0;
+    fun_bc_alloc_diag_overflow_bytes = 0;
+    memset(py_alloc_diag_sites, 0, sizeof(py_alloc_diag_sites));
+    memset(py_alloc_diag_overflow_calls, 0, sizeof(py_alloc_diag_overflow_calls));
+    memset(py_alloc_diag_overflow_bytes, 0, sizeof(py_alloc_diag_overflow_bytes));
+}
