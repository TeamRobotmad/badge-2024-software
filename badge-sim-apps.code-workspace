  "settings": {
    // These paths are relative to each workspace folder. They therefore hide
    // sim/apps only from the parent root, while each app root remains visible.
    "files.exclude": {
      "micropython": true,
      "sim/apps": true
    },
    "files.watcherExclude": {
      "**/micropython/**": true,
      "**/sim/apps/**": true,
      "**/build/**": true,
      "**/build-*/**": true,
      "**/__pycache__/**": true,
      "**/.pytest_cache/**": true
    },
    "search.exclude": {
      "**/build/**": true,
      "**/build-*/**": true,
      "**/__pycache__/**": true,
      "**/.pytest_cache/**": true
    }
